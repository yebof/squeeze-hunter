# Copy to .env in the repository root and fill in what you need. The CLI loads
# the nearest .env automatically; values already set in your shell win.
# See README.md → "Credentials and external services" for where each comes from.

# --- Interactive Brokers (hello / paper / live / emergency-flatten) ---------
# TWS or IB Gateway must run on IBKR_HOST with the API enabled. Paper mode
# requires port 7497 (PaperBroker refuses any other port); live TWS is 7496.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=42
# Paper sub-account id (starts with DU). Leave empty to sum all accounts.
IBKR_ACCOUNT=DU0000000
# Only used by the ib-gateway container in docker/compose.yml (paper login).
IBKR_USERID=
IBKR_PASSWORD=

# --- Finnhub: earnings calendar for `ingest earnings` (f3) ------------------
# https://finnhub.io → dashboard → API key. Free tier is enough.
FINNHUB_KEY=

# --- Alerts (optional): killswitch trips push a message ----------------------
# @BotFather → /newbot → token; chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Slack → Apps → Incoming Webhooks
SLACK_WEBHOOK_URL=

# --- Postgres (only `alembic upgrade head`; the runtime does not read it) ---
SH_DB_URL=postgresql+psycopg://squeeze:squeeze@localhost:5432/squeeze

# --- Reserved: Reddit mention ingest (f4) is not implemented yet -------------
# https://www.reddit.com/prefs/apps → "script" app. Nothing reads these today.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=squeeze-hunter/0.1 by <your-github-handle>

# Any YAML setting can be overridden as SH_<SECTION>__<KEY>, e.g.
# SH_RISK__POSITION_CAP=0.05
